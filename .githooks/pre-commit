#!/usr/bin/env bash
# SPDX-License-Identifier: AGPL-3.0-or-later
# Blocks commits that contain secrets. Enable once per clone: scripts/setup-hooks.sh
set -euo pipefail
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks not found. Install it with: brew install gitleaks" >&2
  exit 1
fi
exec gitleaks git --pre-commit --staged --redact --no-banner
